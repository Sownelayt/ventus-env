{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ventus-tma-cycle-diagnostic-manifest-v1",
  "title": "TMA cycle benchmark failed-attempt diagnostic manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "suite_id",
    "suite_version",
    "device",
    "implementation",
    "measurement",
    "sources",
    "test_signature",
    "command",
    "status",
    "failure_class",
    "reason"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "suite_version": {"type": "string", "pattern": "^v[0-9]+$"},
    "device": {
      "type": "object",
      "required": ["class"],
      "properties": {"class": {"enum": ["h100", "b200", "ventus"]}},
      "additionalProperties": true
    },
    "implementation": {
      "type": "object",
      "required": ["version", "release_state"],
      "additionalProperties": true
    },
    "measurement": {
      "type": "object",
      "required": ["formal", "warmups", "repeats", "pairing", "paid_attempts"],
      "additionalProperties": true
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "test_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {"type": "array", "items": {"type": "string"}},
    "status": {"const": "diagnostic"},
    "failure_class": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
