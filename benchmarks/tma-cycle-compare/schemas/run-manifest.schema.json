{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ventus-tma-cycle-run-manifest-v1",
  "title": "Ventus TMA cycle benchmark run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "suite_id",
    "suite_version",
    "device",
    "implementation",
    "measurement",
    "sources",
    "case_matrix_sha256",
    "test_signature",
    "command",
    "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "suite_version": {"type": "string", "pattern": "^v[0-9]+$"},
    "device": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": {"enum": ["h100", "b200", "ventus"]},
        "name": {"type": "string"},
        "compute_capability": {"type": "string"},
        "driver": {"type": "string"},
        "cuda": {"type": "string"},
        "sm_clock_mhz": {"type": ["integer", "null"]},
        "l2_bytes": {"type": ["integer", "null"]}
      },
      "additionalProperties": true
    },
    "implementation": {
      "type": "object",
      "required": ["version", "release_state"],
      "properties": {
        "version": {"type": "string"},
        "release_state": {"enum": ["reference", "frozen", "development-unfrozen"]},
        "git_commit": {"type": "string"},
        "dirty_patch_sha256": {"type": "string"},
        "simulator_sha256": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      },
      "additionalProperties": true
    },
    "measurement": {
      "type": "object",
      "required": ["formal", "warmups", "repeats", "pairing", "paid_attempts"],
      "properties": {
        "formal": {"type": "boolean"},
        "warmups": {"type": "integer", "minimum": 0},
        "repeats": {"type": "integer", "minimum": 1},
        "pairing": {"type": "string"},
        "paid_attempts": {"type": "integer", "minimum": 0},
        "wait_method": {"type": ["string", "object"]},
        "data_residency": {"type": "string"},
        "descriptor_residency": {"type": "string"},
        "direction_definition": {"type": "string"},
        "context_definition": {"type": "string"},
        "duration_seconds": {"type": "number", "minimum": 0},
        "child_timeout_seconds": {"type": "number", "minimum": 0},
        "function_timeout_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "case_matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "test_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["passed", "failed_validation"]}
  },
  "additionalProperties": true
}
